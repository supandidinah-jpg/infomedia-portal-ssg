---
pagination:
  data: berita
  size: 10
  alias: items
permalink: "/"
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>INFOMEDIA - Portal Berita</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
    body { background: #f4f6f9; color: #333; line-height: 1.6; }
    header { background: #111827; color: #fff; text-align: center; padding: 15px; border-bottom: 4px solid #dc2626; }
    header h1 { font-size: 24px; }
    .container { max-width: 800px; margin: 20px auto; padding: 0 15px; }
    .card { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .card h2 { font-size: 18px; margin-bottom: 10px; }
    .card h2 a { color: #111827; text-decoration: none; }
    .card h2 a:hover { color: #dc2626; }
    .btn-baca { display: inline-block; margin-top: 10px; background: #dc2626; color: #fff; padding: 8px 14px; border-radius: 4px; text-decoration: none; font-size: 13px; font-weight: bold; }
  </style>
</head>
<body>

  <header>
    <h1>INFOMEDIA</h1>
  </header>

  <div class="container">
    {% for item in items %}
      <article class="card">
        <h2><a href="/berita/{{ item.slug }}/">{{ item.judul or item.Judul or "Judul Artikel" }}</a></h2>
        <a href="/berita/{{ item.slug }}/" class="btn-baca">Baca Selengkapnya &rarr;</a>
      </article>
    {% endfor %}
  </div>

</body>
</html>
