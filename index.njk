---
pagination:
  data: berita
  size: 10
  alias: items
permalink: "/"
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>INFOMEDIA - Portal Berita</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
    body { background: #f4f4f4; color: #333; line-height: 1.6; }
    header { background: #1a2a3a; color: #fff; text-align: center; padding: 20px 10px; border-bottom: 4px solid #e63946; }
    header h1 { font-size: 28px; letter-spacing: 2px; }
    .container { max-width: 800px; margin: 20px auto; padding: 0 15px; }
    .card { background: #fff; border-radius: 8px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .card img { width: 100%; max-height: 350px; object-fit: cover; border-radius: 6px; margin-bottom: 12px; }
    .card h2 { margin-bottom: 8px; font-size: 20px; }
    .card h2 a { color: #1a2a3a; text-decoration: none; }
    .card h2 a:hover { color: #e63946; }
    .meta { font-size: 12px; color: #777; margin-bottom: 12px; }
    .card p { font-size: 14px; color: #555; margin-bottom: 15px; }
    .btn-baca { display: inline-block; background: #e63946; color: #fff; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: bold; }
  </style>
</head>
<body>

  <header>
    <h1>INFOMEDIA</h1>
  </header>

  <div class="container">
    {% for item in items %}
      {% set teksIsi = item.isi or item.konten or item.Isi or item.isi_berita or "" %}
      {% set gambarBerita = item.gambar or item.Gambar or item.image %}
      
      <article class="card">
        {% if gambarBerita %}
          <img src="{{ gambarBerita }}" alt="{{ item.judul or item.Judul }}">
        {% endif %}
        <h2><a href="/berita/{{ item.slug }}/">{{ item.judul or item.Judul }}</a></h2>
        <div class="meta">Oleh: {{ item.penulis or item.Penulis or "Supandi" }}</div>
        <p>{{ teksIsi | truncate(150) }}</p>
        <a href="/berita/{{ item.slug }}/" class="btn-baca">Baca Selengkapnya &rarr;</a>
      </article>
    {% endfor %}
  </div>

</body>
</html>
